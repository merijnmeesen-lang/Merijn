{
  "permissions": {
    "allow": [
      "Bash(python -m clipos:*)",
      "Bash(python3 -m clipos:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(pip install anthropic:*)",
      "Bash(pip install openai:*)",
      "Bash(npm install @anthropic-ai/sdk:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "P=\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\"; [ -x \"$P\" ] || P=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$P\" ] || P=$(command -v python3 || command -v python); \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/kostenwacht_hook.py\""
          }
        ]
      }
    ]
  }
}
